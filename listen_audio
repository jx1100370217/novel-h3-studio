#!/usr/bin/env python3
"""Foreground entry point; accepts the same arguments as audio_review.py."""
import os
from pathlib import Path
import sys

repo = Path(__file__).resolve().parent
runtime = repo / '.venv-audio/bin/python'
if not runtime.is_file():
    raise SystemExit('请先运行本项目的 setup_audio.py 安装本地音频环境')
os.execv(str(runtime), [str(runtime), str(repo / 'audio_review.py'), *sys.argv[1:]])
