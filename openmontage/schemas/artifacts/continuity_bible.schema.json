{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/continuity_bible",
  "title": "Continuity Bible",
  "description": "Per-scene, per-shot continuity ledger for V6+ production.",
  "type": "object",
  "required": ["version", "project_id", "scenes"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "sequence_id", "story_day", "time_of_day", "location",
                     "cast", "costume", "props", "axis", "screen_direction", "light", "shots"],
        "properties": {
          "scene_id": {"type": "string", "minLength": 1},
          "sequence_id": {"type": "string", "minLength": 1},
          "story_day": {"type": "integer", "minimum": 1},
          "time_of_day": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "cast": {"type": "array", "items": {"type": "string"}},
          "costume": {"type": "object", "additionalProperties": {"type": "string"}},
          "props": {"type": "array", "items": {"type": "string"}},
          "axis": {"type": "string", "minLength": 1},
          "screen_direction": {"type": "string", "minLength": 1},
          "light": {"type": "string", "minLength": 1},
          "shots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["shot_id", "open_state", "close_state", "cast", "costume_state",
                           "prop_state", "hand_ownership", "eyeline", "axis_side",
                           "screen_direction", "light_state", "time_state", "anchor_image",
                           "continuity_in", "continuity_out"],
              "properties": {
                "shot_id": {"type": "string", "minLength": 1},
                "open_state": {"type": "string", "minLength": 1},
                "close_state": {"type": "string", "minLength": 1},
                "cast": {"type": "array", "items": {"type": "string"}},
                "extras": {"type": "array", "items": {"type": "string"}},
                "costume_state": {"type": "object", "additionalProperties": {"type": "string"}},
                "prop_state": {"type": "object", "additionalProperties": {"type": "string"}},
                "hand_ownership": {"type": "string"},
                "eyeline": {"type": "string", "minLength": 1},
                "axis_side": {"type": "string", "minLength": 1},
                "axis_cross": {"type": "boolean"},
                "screen_direction": {"type": "string", "minLength": 1},
                "light_state": {"type": "string", "minLength": 1},
                "time_state": {"type": "string", "minLength": 1},
                "anchor_image": {"type": "string", "minLength": 1},
                "continuity_in": {"type": "string", "minLength": 1},
                "continuity_out": {"type": "string", "minLength": 1},
                "notes": {"type": "string"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
