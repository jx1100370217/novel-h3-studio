{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/screenplay_treatment",
  "title": "Screenplay Treatment",
  "description": "Cinematic enrichment of a faithful base script. Adds visual storytelling and shot opportunities without adding plot facts or spoken words.",
  "type": "object",
  "required": [
    "version",
    "title",
    "source_script",
    "logline",
    "dramatic_question",
    "theme",
    "visual_motifs",
    "beat_map",
    "added_beats",
    "enhanced_sections",
    "fidelity_ledger",
    "metadata"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_script": {
      "type": "string",
      "description": "Project-relative path or artifact id of the faithful base script."
    },
    "logline": {
      "type": "string",
      "minLength": 1
    },
    "dramatic_question": {
      "type": "string",
      "minLength": 1
    },
    "theme": {
      "type": "string",
      "minLength": 1
    },
    "tone": {
      "type": "string"
    },
    "visual_motifs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "setup_sections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "payoff_sections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "camera_notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "act_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "act",
          "purpose",
          "section_ids"
        ],
        "properties": {
          "act": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "section_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "turn": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "beat_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "beat_id",
          "section_ids",
          "function"
        ],
        "properties": {
          "beat_id": {
            "type": "string",
            "minLength": 1
          },
          "section_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "function": {
            "type": "string",
            "minLength": 1
          },
          "escalation": {
            "type": "string"
          },
          "visual_idea": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "added_beats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "after_section",
          "source_paragraph_ids",
          "type",
          "description",
          "why_cinematic",
          "fidelity_risk"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "after_section": {
            "type": "string"
          },
          "source_paragraph_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "type": {
            "type": "string",
            "enum": [
              "reaction",
              "insert",
              "establishing",
              "transition",
              "motif",
              "parallel_action",
              "reveal",
              "aftermath",
              "sensory",
              "spatial_continuity",
              "sound_bridge",
              "foreshadow",
              "payoff",
              "crowd_detail"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "why_cinematic": {
            "type": "string",
            "minLength": 1
          },
          "fidelity_risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "extra_seconds": {
            "type": "number"
          },
          "absorbed_from": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "enhanced_sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "start_seconds",
          "end_seconds",
          "source_paragraph_ids",
          "cinematic_function",
          "added"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "original_section_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "minimum": 0
          },
          "source_paragraph_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "cinematic_function": {
            "type": "string",
            "minLength": 1
          },
          "visual_motif": {
            "type": "string"
          },
          "shot_opportunity": {
            "type": "string"
          },
          "added": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "shot_opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "shot_size",
          "composition",
          "why"
        ],
        "properties": {
          "section_id": {
            "type": "string"
          },
          "shot_size": {
            "type": "string",
            "enum": [
              "extreme_wide",
              "wide",
              "medium_wide",
              "medium",
              "medium_close",
              "close_up",
              "extreme_close_up",
              "over_shoulder",
              "insert",
              "establishing"
            ]
          },
          "lens_mm": {
            "type": "integer"
          },
          "camera_movement": {
            "type": "string"
          },
          "composition": {
            "type": "string"
          },
          "lighting": {
            "type": "string"
          },
          "sound": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "transition_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from_section",
          "to_section",
          "type",
          "description"
        ],
        "properties": {
          "from_section": {
            "type": "string"
          },
          "to_section": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "hard_cut",
              "match_cut",
              "sound_bridge",
              "fade",
              "dissolve",
              "whip_pan",
              "eyeline_cut",
              "action_cut",
              "graphic_match"
            ]
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "sound_plan": {
      "type": "object",
      "properties": {
        "motifs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "silence_windows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diegetic_texture": {
          "type": "string"
        },
        "music_policy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "fidelity_ledger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_fact",
          "treatment",
          "status"
        ],
        "properties": {
          "source_fact": {
            "type": "string",
            "minLength": 1
          },
          "treatment": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "preserved",
              "visualized",
              "compressed",
              "ambiguous"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "not_added": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "idea",
          "reason"
        ],
        "properties": {
          "idea": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "production_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "runtime_target_seconds",
        "runtime_after_seconds",
        "added_section_count",
        "fidelity_status"
      ],
      "properties": {
        "source_script_sha256": {
          "type": "string"
        },
        "runtime_target_seconds": {
          "type": "number",
          "minimum": 1
        },
        "runtime_after_seconds": {
          "type": "number",
          "minimum": 1
        },
        "added_section_count": {
          "type": "integer",
          "minimum": 0
        },
        "fidelity_status": {
          "type": "string",
          "enum": [
            "pass",
            "revise"
          ]
        }
      },
      "additionalProperties": true
    },
    "shot_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "section_id",
          "title",
          "frames",
          "duration_seconds",
          "shot_type",
          "camera",
          "lighting",
          "blocking",
          "start_state",
          "end_state",
          "action_beats",
          "sound",
          "cast",
          "visible_cast_count",
          "continuity",
          "h3_prompt_notes"
        ],
        "properties": {
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "frames": {
            "type": "integer",
            "minimum": 5
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0.1
          },
          "shot_type": {
            "type": "string",
            "enum": [
              "single_take",
              "insert",
              "reaction",
              "montage",
              "transition",
              "establishing"
            ]
          },
          "camera": {
            "type": "object",
            "required": [
              "shot_size",
              "lens_mm",
              "movement",
              "composition"
            ],
            "properties": {
              "shot_size": {
                "type": "string",
                "enum": [
                  "extreme_wide",
                  "wide",
                  "medium_wide",
                  "medium",
                  "medium_close",
                  "close_up",
                  "extreme_close_up",
                  "over_shoulder",
                  "insert",
                  "establishing"
                ]
              },
              "lens_mm": {
                "type": "integer"
              },
              "movement": {
                "type": "string",
                "minLength": 1
              },
              "height": {
                "type": "string"
              },
              "composition": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "lighting": {
            "type": "object",
            "required": [
              "key",
              "fill",
              "practicals",
              "contrast",
              "color_temperature"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "fill": {
                "type": "string"
              },
              "practicals": {
                "type": "string"
              },
              "contrast": {
                "type": "string"
              },
              "color_temperature": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "blocking": {
            "type": "string",
            "minLength": 1
          },
          "start_state": {
            "type": "string",
            "minLength": 1
          },
          "end_state": {
            "type": "string",
            "minLength": 1
          },
          "action_beats": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sound": {
            "type": "string",
            "minLength": 1
          },
          "cast": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visible_cast_count": {
            "type": "integer",
            "minimum": 0
          },
          "props": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "costume": {
            "type": "string"
          },
          "set_dressing": {
            "type": "string"
          },
          "continuity": {
            "type": "string",
            "minLength": 1
          },
          "h3_prompt_notes": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "type": "string"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "added_dialogue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "line_id",
          "scene_id",
          "speaker",
          "text",
          "source_fact",
          "purpose"
        ],
        "properties": {
          "line_id": {
            "type": "string",
            "minLength": 1
          },
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "speaker": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_fact": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
